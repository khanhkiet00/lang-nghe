POSTGRES_USER=langnghe
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=langnghe

DATABASE_URL=postgresql://langnghe:change_me_strong_password@postgres:5432/langnghe

# ==========================================
# BACKEND CONFIG
# ==========================================
NODE_ENV=production
PORT=3001
JWT_SECRET=change_me_long_random_secret

# Local Docker demo:
# CORS_ORIGINS=http://localhost
#
# Ngrok demo:
# CORS_ORIGINS=https://your-ngrok-url.ngrok-free.dev
CORS_ORIGINS=http://localhost

# ==========================================
# STORAGE & AI
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
FPT_AI_API_KEY=your_fpt_ai_api_key

# Browser-facing API URL.
# Local Docker demo:
# NEXT_PUBLIC_API_URL=http://localhost/api/v1
#
# Ngrok demo:
# NEXT_PUBLIC_API_URL=https://your-ngrok-url.ngrok-free.dev/api/v1
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# Internal Docker network URL for Next.js Server Components.
API_INTERNAL_URL=http://backend:3001/api/v1

# ==========================================
# EMAIL SERVICES
# ==========================================
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
