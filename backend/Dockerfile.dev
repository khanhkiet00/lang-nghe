FROM node:20-slim
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
# Copy prisma schema BEFORE npm install so generate runs with correct platform
COPY prisma/ ./prisma/
RUN npm install
# ✅ Generate Prisma Client INSIDE container (correct platform - Debian OpenSSL 3.0)
RUN npx prisma generate
COPY . .
CMD ["npm", "run", "start:dev"]
